      "css": {
        "@keyframes rise": {
          "from": {
            "opacity": "0",
            "transform": "translateY(6px)"
          }
        },
        "@keyframes grow-y": {
          "from": {
            "transform": "scaleY(0)"
          }
        },
        "@keyframes grow-x": {
          "from": {
            "transform": "scaleX(0)"
          }
        },
        "@keyframes fade": {
          "from": {
            "opacity": "0"
          }
        },
        "@layer base": {
          "html": {
            "scroll-behavior": "smooth"
          },
          "h1, h2, h3, h4": {
            "text-wrap": "balance"
          },
          "p": {
            "text-wrap": "pretty"
          }
        },
        "@layer utilities": {
          ".animate-grow-y": {
            "transform-origin": "bottom"
          },
          "@media (prefers-reduced-motion: reduce)": {
            ".animate-rise": {
              "animation-name": "fade"
            },
            ".animate-grow-y, .animate-grow-x": {
              "animation": "none"
            }
          }
        }
      }
    },
