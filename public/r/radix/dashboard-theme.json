{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-theme",
  "title": "Dashboard theme",
  "description": "Warm neutral palette with one moss accent, Geist type, tinted shadows, strong easing curves and entrance animations used by the dashboard template.",
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-geist-sans, ui-sans-serif, system-ui, sans-serif)",
      "font-mono": "var(--font-geist-mono, ui-monospace, monospace)",
      "font-heading": "var(--font-geist-sans, ui-sans-serif, system-ui, sans-serif)",
      "color-brand": "var(--brand)",
      "color-brand-foreground": "var(--brand-foreground)",
      "color-success": "var(--success)",
      "color-warning": "var(--warning)",
      "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
      "ease-drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
      "shadow-xs": "0 1px 2px hsl(var(--shadow-color) / 0.05)",
      "shadow-sm": "0 1px 2px hsl(var(--shadow-color) / 0.04), 0 2px 6px -2px hsl(var(--shadow-color) / 0.06)",
      "shadow-md": "0 1px 2px hsl(var(--shadow-color) / 0.04), 0 8px 24px -8px hsl(var(--shadow-color) / 0.12)",
      "animate-rise": "rise 280ms var(--ease-out) calc(var(--i, 0) * 50ms) both",
      "animate-grow-y": "grow-y 560ms var(--ease-out) calc(120ms + var(--i, 0) * 25ms) both",
      "animate-grow-x": "grow-x 640ms var(--ease-out) calc(160ms + var(--i, 0) * 60ms) both"
    },
    "light": {
      "background": "oklch(0.99 0.002 80)",
      "foreground": "oklch(0.2 0.006 80)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.2 0.006 80)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.2 0.006 80)",
      "primary": "oklch(0.24 0.008 80)",
      "primary-foreground": "oklch(0.985 0.002 80)",
      "secondary": "oklch(0.96 0.004 80)",
      "secondary-foreground": "oklch(0.24 0.008 80)",
      "muted": "oklch(0.96 0.004 80)",
      "muted-foreground": "oklch(0.52 0.008 80)",
      "accent": "oklch(0.955 0.005 80)",
      "accent-foreground": "oklch(0.24 0.008 80)",
      "brand": "oklch(0.52 0.09 160)",
      "brand-foreground": "oklch(0.985 0.002 80)",
      "success": "oklch(0.52 0.09 160)",
      "warning": "oklch(0.62 0.11 70)",
      "destructive": "oklch(0.56 0.16 27)",
      "border": "oklch(0.91 0.005 80)",
      "input": "oklch(0.89 0.005 80)",
      "ring": "oklch(0.52 0.09 160 / 60%)",
      "chart-1": "oklch(0.52 0.09 160)",
      "chart-2": "oklch(0.78 0.05 160)",
      "chart-3": "oklch(0.62 0.11 70)",
      "chart-4": "oklch(0.52 0.008 80)",
      "chart-5": "oklch(0.8 0.006 80)",
      "shadow-color": "80 10% 20%",
      "sidebar": "oklch(0.975 0.003 80)",
      "sidebar-foreground": "oklch(0.24 0.008 80)",
      "sidebar-primary": "oklch(0.24 0.008 80)",
      "sidebar-primary-foreground": "oklch(0.985 0.002 80)",
      "sidebar-accent": "oklch(0.935 0.005 80)",
      "sidebar-accent-foreground": "oklch(0.2 0.006 80)",
      "sidebar-border": "oklch(0.91 0.005 80)",
      "sidebar-ring": "oklch(0.52 0.09 160 / 60%)",
      "radius": "0.625rem"
    },
    "dark": {
      "background": "oklch(0.17 0.004 80)",
      "foreground": "oklch(0.95 0.003 80)",
      "card": "oklch(0.2 0.004 80)",
      "card-foreground": "oklch(0.95 0.003 80)",
      "popover": "oklch(0.21 0.004 80)",
      "popover-foreground": "oklch(0.95 0.003 80)",
      "primary": "oklch(0.93 0.004 80)",
      "primary-foreground": "oklch(0.2 0.006 80)",
      "secondary": "oklch(0.25 0.004 80)",
      "secondary-foreground": "oklch(0.95 0.003 80)",
      "muted": "oklch(0.25 0.004 80)",
      "muted-foreground": "oklch(0.68 0.006 80)",
      "accent": "oklch(0.26 0.005 80)",
      "accent-foreground": "oklch(0.95 0.003 80)",
      "brand": "oklch(0.72 0.1 160)",
      "brand-foreground": "oklch(0.18 0.01 160)",
      "success": "oklch(0.74 0.1 160)",
      "warning": "oklch(0.78 0.11 75)",
      "destructive": "oklch(0.68 0.15 25)",
      "border": "oklch(1 0 0 / 8%)",
      "input": "oklch(1 0 0 / 12%)",
      "ring": "oklch(0.72 0.1 160 / 55%)",
      "chart-1": "oklch(0.72 0.1 160)",
      "chart-2": "oklch(0.45 0.06 160)",
      "chart-3": "oklch(0.78 0.11 75)",
      "chart-4": "oklch(0.68 0.006 80)",
      "chart-5": "oklch(0.4 0.005 80)",
      "shadow-color": "80 20% 2%",
      "sidebar": "oklch(0.185 0.004 80)",
      "sidebar-foreground": "oklch(0.95 0.003 80)",
      "sidebar-primary": "oklch(0.93 0.004 80)",
      "sidebar-primary-foreground": "oklch(0.2 0.006 80)",
      "sidebar-accent": "oklch(0.25 0.005 80)",
      "sidebar-accent-foreground": "oklch(0.95 0.003 80)",
      "sidebar-border": "oklch(1 0 0 / 7%)",
      "sidebar-ring": "oklch(0.72 0.1 160 / 55%)"
    }
  },
  "css": {
    "@keyframes rise": {
      "from": {
        "opacity": "0",
        "transform": "translateY(6px)"
      }
    },
    "@keyframes grow-y": {
      "from": {
        "transform": "scaleY(0)"
      }
    },
    "@keyframes grow-x": {
      "from": {
        "transform": "scaleX(0)"
      }
    },
    "@keyframes fade": {
      "from": {
        "opacity": "0"
      }
    },
    "@layer base": {
      "html": {
        "scroll-behavior": "smooth"
      },
      "h1, h2, h3, h4": {
        "text-wrap": "balance"
      },
      "p": {
        "text-wrap": "pretty"
      }
    },
    "@layer utilities": {
      ".animate-grow-y": {
        "transform-origin": "bottom"
      },
      "@media (prefers-reduced-motion: reduce)": {
        ".animate-rise": {
          "animation-name": "fade"
        },
        ".animate-grow-y, .animate-grow-x": {
          "animation": "none"
        }
      }
    }
  },
  "type": "registry:theme"
}